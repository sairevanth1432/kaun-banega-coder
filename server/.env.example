# Local development: copy to server/.env (optional; everything below has a working default locally).
# Vercel: set these in Project → Settings → Environment Variables.

# ---- required in production
# APP_SECRET=                   # 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=                  # random string; Vercel Cron sends it to /api/cron/cleanup

# ---- data stores
# DATABASE_URL=postgres://…-pooler…/neondb?sslmode=require   # Neon: use the POOLED connection string. Unset = PGlite in data/
# DB_POOL_MAX=5
# REDIS_URL=redis://localhost:6379   # self-hosted Redis
# KV_REST_API_URL=                   # or Upstash Redis over HTTP (Vercel)
# KV_REST_API_TOKEN=

# ---- server
# PORT=3000
# TRUST_PROXY=1                 # behind a reverse proxy
# ADMIN_REQUIRE_TOTP=true       # admins must use an authenticator app (keep on in production)
# ADMIN_SESSION_HOURS=8
# STUDENT_SESSION_DAYS=7

# ---- game
# ANSWER_GRACE_MS=3000          # network slack after a question's timer runs out
# MAX_GAMES_PER_HOUR=60         # per player
# MOVES_PER_MINUTE=120          # answers, lifelines, next… per player
