{
  "name": "kbc-server",
  "private": true,
  "type": "module",
  "description": "Kaun Banega Coder: question bank, server-checked quiz game and admin portal.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=. index.js",
    "create-admin": "node scripts/create-admin.js",
    "seed": "node scripts/seed.js",
