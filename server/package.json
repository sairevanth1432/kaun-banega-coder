    "loadtest": "node scripts/loadtest.js",
    "test": "node --test --test-concurrency=1 test/e2e.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@upstash/redis": "^1.39.0",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "read-excel-file": "^9.3.10",
    "redis": "^6.3.0"
